PRODUCT_NAME = Bigboard
PRODUCT_MODULE_NAME = BigboardDesktop
PRODUCT_BUNDLE_IDENTIFIER = com.richhaase.bigboard
BIGBOARD_DISPLAY_NAME = Bigboard
BIGBOARD_REQUIRE_AUTH = NO
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 0.0.0
INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_VERSION = 6.0
MACOSX_DEPLOYMENT_TARGET = 26.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
ALWAYS_SEARCH_USER_PATHS = NO

EXECUTABLE_NAME = Bigboard
